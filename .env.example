# ─── FREE RICKY - Variables de Entorno ──────────────────────────────────
# Copia este archivo como .env y rellena los valores.
# cp .env.example .env
#
# IMPORTANTE: NUNCA versiones el archivo .env en Git.
# El archivo .env está en .gitignore para evitar filtración de credenciales.

# ─── DJANGO ────────────────────────────────────────────────────────────
# Clave secreta para firmar sesiones y datos cifrados.
# Genera una nueva con: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Vacía a propósito (ver "LAS TRES CONTRASEÑAS" más abajo): un valor de ejemplo
# en una plantilla acaba en producción, y con él se pueden falsificar sesiones y
# tokens firmados con esa clave.
SECRET_KEY=

# Clave para firmar tokens JWT.
# Genera una nueva con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=

# Modo debug: True para desarrollo, False para producción.
DEBUG=False

# Hosts permitidos (separados por coma).
# En Docker incluye "backend" para que nginx pueda comunicarse con Django.
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# Orígenes CORS permitidos (separados por coma).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# URLs base para generación de enlaces internos.
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000

# ─── BASE DE DATOS ─────────────────────────────────────────────────────
# En Docker, DB_HOST=mysql y DB_PORT=3306 se establecen automáticamente
# en docker-compose.yml. Solo necesitas configurar estas si corres Django
# fuera de Docker.
DB_NAME=free_ricky
DB_USER=free_ricky
DB_HOST=localhost
DB_PORT=3307

# Las tres contraseñas de abajo van VACÍAS a propósito.
#
# Antes esta plantilla traía valores literales (`DB_PASSWORD=root`) y quien copiaba
# el fichero sin editarlo se quedaba con una contraseña conocida de todo el mundo.
# Compose las exige con ${VAR:?}, así que una plantilla vacía hace que `docker
# compose up` FALLE con un mensaje claro en vez de arrancar con un secreto
# público. Vacío es fail-closed; un placeholder tipo "cambiaesto" es fail-open.
#
# Genéralas de una vez (no reutilices valores ni los pegues de otros proyectos):
#   python -c "import secrets; [print(k+'=secrets.token_urlsafe(24)') for k in ('DB_PASSWORD','MYSQL_ROOT_PASSWORD','REDIS_PASSWORD')]"
#
# Deben ser DISTINTAS entre sí. Con la misma contraseña, root de MySQL, el usuario
# de la aplicación y Redis comparten un único secreto: comprometer el usuario de
# la app ES ser root, y adivinar Redis ES entrar en la base de datos.
DB_PASSWORD=

MYSQL_ROOT_PASSWORD=

REDIS_PASSWORD=

# ─── CACHE ─────────────────────────────────────────────────────────────
# En Docker se usa redis://${REDIS_PASSWORD}@redis:6379/0 automáticamente.
# Para desarrollo local sin Redis, deja esta variable vacía.
CACHE_URL=redis://127.0.0.1:6379/0

# ─── FICHERO DE SECRETOS DE REDIS ──────────────────────────────────────
# Redis NO lee su contraseña de .env: la lee de un fichero ACL propio, montado
# en solo lectura. Así no aparece en la línea de comandos del proceso (ni en
# `ps` ni en /proc/cmdline), ni en la config del contenedor.
#
# Ese fichero NO se versiona (está en .gitignore). Créalo después de rellenar .env:
#   mkdir -p secrets
#   printf 'user default on >%s ~* &* +@all\n' "$REDIS_PASSWORD" > secrets/redis.acl
#
# Si no existe, Redis se niega a arrancar diciendo qué falta (ver docker-compose.yml).
#
# MySQL conserva su contraseña en el entorno del contenedor porque la imagen
# oficial la necesita para inicializar la base de datos y no admite el convenio
# _FILE. Ver la nota de la cabecera de docker-compose.yml.

# ─── JWT ───────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1

# ─── SEGURIDAD ────────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=False

# Cookie HTTP-only de refresh: `Secure` en producción, no en DEBUG. Fuerza el
# valor cuando el despliegue real es por http (p. ej. FRONTEND_BIND=0.0.0.0
# para probar desde el móvil en la LAN sin TLS): con DEBUG=False una cookie
# Secure se descartaría en navegadores y la sesión moriría a los 15 minutos.
# REFRESH_COOKIE_SECURE=False

# Redes desde las que Django acepta X-Real-IP / X-Forwarded-For para saber la
# IP real del cliente (rate limiting y bloqueo por fuerza bruta). Solo quien
# está en esta lista puede elegir su propia identidad, así que debe ser
# estrecha: la del proxy que hay delante y nada más.
#
# No hace falta definirla: el valor por defecto es loopback + la red de Docker
# (subnet fijada en docker-compose.yml). Descoméntala SOLO si hay un
# balanceador o proxy fuera de compose, con su IP/rango real:
# TRUSTED_PROXIES=203.0.113.10

# ─── EMAIL (SMTP GMAIL) ──────────────────────────────────────────────
# Para enviar correos reales con Gmail:
# 1. Activa 2FA (Verificación en 2 pasos) en tu cuenta Google
# 2. Crea una "App Password" en https://myaccount.google.com/apppasswords
#    (si no aparece, es porque la 2FA sigue desactivada)
# 3. Copia la contraseña de 16 letras SIN espacios en EMAIL_HOST_PASSWORD
#
# MIENTRAS EMAIL_HOST_PASSWORD ESTÉ VACÍO, Django usa el backend de consola:
# el API responde 200 y el frontend dice "Correo enviado", pero el correo
# acaba en la terminal (docker compose logs backend / consola de runserver),
# NO en tu Gmail. El arranque y cada envío lo avisan en el log.
#
# Comprobación en un minuto, sin tocar el flujo completo:
#   cd backend && python manage.py sendtestemail tu@gmail.com
# Debe llegar a los 5-10 segundos. Si no llega, mira el log: o falta la
# contraseña, o Gmail está rechazando la App Password (revísala).
EMAIL_HOST_USER=tu@email.com
EMAIL_HOST_PASSWORD=TU_APP_PASSWORD_DE_GMAIL
DEFAULT_FROM_EMAIL=FREE RICKY <tu@email.com>
# Gmail: 587 + STARTTLS (los valores por defecto). Solo cámbialo si usas
# otro proveedor: 465 implica EMAIL_USE_SSL=True y EMAIL_USE_TLS=False.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=20
