# Variables de entorno para desarrollo con `npm run dev`.
# Copia este archivo como .env.local (ignorado por git) y ajusta los valores.
# En Docker NO se leen: docker-compose inyecta GAME_ORIGIN como build-arg y
# el Dockerfile lo compila tanto en el bundle como en la CSP de Nginx.

# Base de la API. Vacio usa el proxy relativo "/api".
VITE_API_URL=

# Origen donde se sirve el build de Unity WebGL (sin barra final).
VITE_GAME_ORIGIN=http://192.168.18.50:8080

# URL completa del iframe, solo si difiere de "<origen>/?v=...".
# VITE_GAME_URL=

# Compatibilidad temporal con los mensajes legacy del build de Unity.
# Ponlo a "false" cuando el juego envíe el contrato de docs/PROTOCOLO_UNITY.md.
VITE_UNITY_LEGACY_COMPAT=true
